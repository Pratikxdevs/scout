# Frontend env. Copy to .env.local for local overrides — never commit secrets.
# Log ingest = Convex httpAction (different origin/port from this dev server).
# Live dev viewer (own port, memory-only, no storage): the app mirrors every
# flushed line there in parallel with ingest. Empty = viewer transport off.
VITE_LOG_VIEWER_URL=http://127.0.0.1:3999
VITE_ENVIRONMENT=development
VITE_LOG_INGEST_URL=
VITE_SENTRY_DSN=
# Convex backend (Better Auth + API). Dev deployment values live in
# server/.env.local — copy CONVEX_URL/CONVEX_SITE_URL here as VITE_*.
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=
# Auth API proxy target (dev only; defaults to the dev deployment).
# Same-origin /api/auth keeps cookies first-party — do NOT point the
# auth client at Convex directly or the OAuth state cookie dies.
VITE_AUTH_PROXY_TARGET=
# Live dev viewer has no in-app page anymore (see server/logviewer.py);
# the flag below is retired and ignored — delete it on your next edit.
VITE_DEBUG_LOGS=true

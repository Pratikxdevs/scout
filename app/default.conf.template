# SPA fallback: every non-asset route serves index.html (hand-rolled router).
# Auth API is same-origin proxied to Convex (CONVEX_SITE_URL at container
# start) so auth cookies stay first-party — cross-site Set-Cookie gets
# blocked and kills the OAuth callback state. Data-plane calls go direct
# to Convex from the browser (CORS allowlist server-side).
# Rendered by envsubst at container start (nginx /docker-entrypoint.d/).
# Empty CONVEX_SITE_URL falls back to a dead port: auth answers 502 (never
# the SPA shell — an HTML answer to /api/auth/* is exactly the failure
# mode this proxy exists to prevent).
server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  location /api/auth/ {
    proxy_pass ${CONVEX_SITE_URL:-http://127.0.0.1:9};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Cookie $http_cookie;
    proxy_pass_header Set-Cookie;
    proxy_cookie_path / /;
    proxy_connect_timeout 10s;
    proxy_read_timeout 30s;
  }

  # Session-cookie bearer: the ensure route resolves the caller's session
  # from cookies server-side, so it rides the same same-origin proxy.
  # (Data-plane /api/v1/* stays direct with Bearer auth — least surface.)
  location = /api/v1/auth/ensure {
    proxy_pass ${CONVEX_SITE_URL:-http://127.0.0.1:9};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Cookie $http_cookie;
    proxy_pass_header Set-Cookie;
    proxy_cookie_path / /;
    proxy_connect_timeout 10s;
    proxy_read_timeout 30s;
  }

  # Long-cache hashed assets; never cache the shell.
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }
  location = /index.html {
    expires -1;
    add_header Cache-Control "no-store";
  }
  location / {
    try_files $uri $uri/ /index.html;
  }
}
